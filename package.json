{
  "name": "canvas-notion-sync",
  "version": "1.1.0",
  "description": "Chrome extension to sync Canvas LMS assignments with Notion",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:integration-rate": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration-rate.config.js --runTestsByPath test/integration/notion-rate-limiter.integration.test.js --runInBand",
    "lint": "eslint . --ext .js --config .eslintrc.security.json --ignore-pattern '.github/'",
    "check:security": "node .github/scripts/check-manifest-security.cjs",
    "check:version": "node .github/scripts/check-version-sync.cjs",
    "bump": "node scripts/bump-version.mjs",
    "publish:store": "node scripts/publish-store.mjs",
    "build:zip": "node scripts/build-zip.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs"
  },
  "keywords": [
    "canvas",
    "notion",
    "chrome-extension",
    "lms",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@jest/globals": "^30.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-no-secrets": "^1.0.2",
    "eslint-plugin-security": "^2.1.0",
    "jest": "^30.2.0"
  }
}
